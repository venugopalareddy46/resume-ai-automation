# Copy this file to backend/.env and fill in your real values.
# .env is never included in this update - keep your existing keys.

JWT_SECRET_KEY=change-me-to-a-long-random-string

DATABASE_URL=sqlite:///./resume_tailor.db

# AI providers - fill in whichever you use from the model toggle
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Only needed if you also want the local Ollama fallback
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# Comma-separated extra origins allowed to call this API in production,
# e.g. your Elastic Beanstalk URL
CORS_ORIGINS=
